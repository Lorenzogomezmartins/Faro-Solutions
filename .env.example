# ─────────────────────────────────────────────────────────────
# Faro Solutions — variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# ── Envío de correos del formulario de contacto (Resend) ──
# Clave privada de https://resend.com/api-keys (solo servidor, nunca NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Casilla institucional que recibe las consultas.
CONTACT_TO_EMAIL=contacto@tu-dominio.com

# Remitente verificado en Resend (dominio propio verificado).
# Para pruebas sin dominio verificado podés usar: Faro Solutions <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Faro Solutions <web@tu-dominio.com>
